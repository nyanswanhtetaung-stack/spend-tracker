# Copy this file to ".env" and fill in the two values from
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key...

# Note: Vite only exposes variables that start with VITE_ to the browser.
# That is intentional here — the anon key is MEANT to be public, and Row
# Level Security in the database is what actually protects your rows.
# Never put a service_role key in this file. That one bypasses RLS entirely.
